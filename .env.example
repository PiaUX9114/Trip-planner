# M0 IS INTENTIONALLY UNCONNECTED. Leave everything blank for local scaffold preview.
# Copy to .env.local when provider integration is approved.
# NEXT_PUBLIC values are visible to users in browser bundles; NEVER use secrets here.

# Supabase project URL and client publishable key (not the service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser key: restrict to Maps JavaScript API and authorized HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Server-only key for future authorized server-side Routes / Places integrations.
# Never expose this in a NEXT_PUBLIC variable. Not used in M0.
GOOGLE_MAPS_SERVER_KEY=
